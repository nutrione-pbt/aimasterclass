<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AI 마스터클래스 1일차</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css">
<style>
:root {
  --bg: #f7f7f5; --surface: #ffffff; --surface-2: #f1f1ee; --line: #e4e4df;
  --text: #1d1d1b; --text-2: #55554f; --text-3: #8a8a83;
  --accent: #d9612b; --accent-soft: #fbece4; --accent-text: #a8461a;
  --tip: #2f6fdb; --tip-soft: #e9f0fc; --key: #1f8a5b; --key-soft: #e6f4ed; --warn: #b7791f; --warn-soft: #fbf3e2;
  --code-bg: #f4f3ef; --prompt-bg: #1f2230; --prompt-text: #e9eaf2; --prompt-head: #2b2f40;
  --radius: 12px; --sidebar: 280px;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #151514; --surface: #1d1d1b; --surface-2: #252523; --line: #33332f;
    --text: #ededea; --text-2: #b4b4ad; --text-3: #83837c;
    --accent: #f0814c; --accent-soft: #3a261c; --accent-text: #f7a57c;
    --tip: #7aa7f5; --tip-soft: #1c2638; --key: #5cc996; --key-soft: #17291f; --warn: #e2b45c; --warn-soft: #2e2615;
    --code-bg: #232321; --prompt-bg: #10121a; --prompt-text: #e3e5ef; --prompt-head: #1b1e2a;
  }
}
:root[data-theme="dark"] {
  --bg: #151514; --surface: #1d1d1b; --surface-2: #252523; --line: #33332f;
  --text: #ededea; --text-2: #b4b4ad; --text-3: #83837c;
  --accent: #f0814c; --accent-soft: #3a261c; --accent-text: #f7a57c;
  --tip: #7aa7f5; --tip-soft: #1c2638; --key: #5cc996; --key-soft: #17291f; --warn: #e2b45c; --warn-soft: #2e2615;
  --code-bg: #232321; --prompt-bg: #10121a; --prompt-text: #e3e5ef; --prompt-head: #1b1e2a;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 72px; }
body { margin: 0; background: var(--bg); color: var(--text);
  font-family: "Pretendard Variable", Pretendard, -apple-system, "Segoe UI", "Malgun Gothic", sans-serif;
  font-size: 16px; line-height: 1.75; word-break: keep-all; overflow-wrap: anywhere; }
a { color: var(--accent-text); }
code { font-family: "D2Coding", Consolas, "SF Mono", monospace; font-size: .88em; background: var(--surface-2);
  padding: .1em .4em; border-radius: 5px; border: 1px solid var(--line); }

/* 상단 바 */
.topbar { position: sticky; top: 0; z-index: 20; height: 56px; display: flex; align-items: center; gap: 12px;
  padding: 0 20px; background: color-mix(in srgb, var(--surface) 88%, transparent); backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--line); }
.topbar .brand { font-weight: 700; font-size: 15px; white-space: nowrap; }
.topbar .brand span { color: var(--accent); }
.progress { flex: 1; display: flex; align-items: center; gap: 10px; justify-content: flex-end; font-size: 13px; color: var(--text-2); }
.progress .bar { width: 160px; height: 6px; background: var(--surface-2); border-radius: 99px; overflow: hidden; }
.progress .bar i { display: block; height: 100%; width: 0; background: var(--accent); transition: width .3s; }
.icon-btn { border: 1px solid var(--line); background: var(--surface); color: var(--text); border-radius: 8px;
  height: 34px; min-width: 34px; padding: 0 10px; cursor: pointer; font: inherit; font-size: 13px; white-space: nowrap; flex: none; }
#menuBtn { display: none; }

/* 레이아웃 */
.layout { display: grid; grid-template-columns: var(--sidebar) minmax(0, 1fr); max-width: 1320px; margin: 0 auto; }
.sidebar { position: sticky; top: 56px; height: calc(100vh - 56px); overflow-y: auto; padding: 24px 12px 40px 20px;
  border-right: 1px solid var(--line); font-size: 14px; }
.nav-top { display: block; padding: 7px 10px; border-radius: 8px; color: var(--text); text-decoration: none; font-weight: 600; line-height: 1.45; }
.nav-top:hover { background: var(--surface-2); }
.nav-num { display: block; font-size: 11.5px; font-weight: 700; color: var(--accent); letter-spacing: .02em; }
.nav-group { margin-top: 6px; }
.nav-subs { display: none; padding: 2px 0 6px 10px; border-left: 2px solid var(--line); margin-left: 12px; }
.nav-group.open .nav-subs { display: block; }
.nav-sub { display: block; padding: 4px 10px; color: var(--text-2); text-decoration: none; font-size: 13px; line-height: 1.45; border-radius: 6px; }
.nav-sub:hover { background: var(--surface-2); color: var(--text); }
.nav-top.active, .nav-sub.active { color: var(--accent-text); background: var(--accent-soft); }
main { padding: 32px 48px 120px; min-width: 0; }
.wrap { max-width: 860px; }

/* 히어로 */
.hero { padding: 8px 0 28px; }
.eyebrow { display: inline-block; font-size: 13px; font-weight: 700; color: var(--accent-text); background: var(--accent-soft);
  padding: 4px 10px; border-radius: 99px; }
.hero h1 { font-size: clamp(28px, 4vw, 40px); line-height: 1.25; margin: 14px 0 12px; letter-spacing: -0.02em; }
.hero .lead { font-size: 17px; color: var(--text-2); margin: 0 0 20px; }
.stats { display: flex; flex-wrap: wrap; gap: 10px; }
.stat { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 10px 14px; font-size: 14px; color: var(--text-2); }
.stat b { color: var(--text); font-size: 16px; margin-right: 4px; }

.card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px 26px; margin: 20px 0; }
.card h2 { margin: 0 0 12px; font-size: 22px; }
.howto { counter-reset: s; list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
.howto li { counter-increment: s; display: grid; grid-template-columns: 30px 1fr; gap: 10px; align-items: start; }
.howto li::before { content: counter(s); width: 26px; height: 26px; border-radius: 50%; background: var(--accent); color: #fff;
  display: grid; place-items: center; font-size: 13px; font-weight: 700; margin-top: 2px; }
.legend { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; font-size: 13px; }
.legend span { padding: 3px 10px; border-radius: 99px; border: 1px solid var(--line); background: var(--surface-2); }

/* 교시 */
.session, .setup { margin-top: 56px; }
.session-head { border-top: 3px solid var(--accent); padding-top: 22px; }
.session-meta { display: flex; gap: 10px; align-items: center; }
.badge { background: var(--accent); color: #fff; font-weight: 700; font-size: 13px; padding: 3px 10px; border-radius: 6px; }
.time { font-size: 14px; color: var(--text-2); }
.session h2, .setup h2 { font-size: clamp(24px, 3vw, 30px); line-height: 1.3; margin: 10px 0 6px; letter-spacing: -0.015em; }
.session-result { margin: 0 0 18px; color: var(--text-2); font-size: 15px; }
.materials { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px 20px; margin: 0 0 28px; }
.mat-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
.materials ul { list-style: none; padding: 0; margin: 10px 0 0; display: grid; gap: 6px; }
.materials li { display: flex; gap: 8px; align-items: baseline; font-size: 14.5px; }
.mat-kind { font-size: 12px; color: var(--text-3); min-width: 58px; }
.mat-desc { color: var(--text-3); font-size: 13px; }
.mat-help { font-size: 13px; color: var(--text-3); margin: 10px 0 0; }
.btn { display: inline-block; font-size: 13.5px; font-weight: 600; padding: 7px 14px; border-radius: 8px;
  background: var(--accent-soft); color: var(--accent-text); text-decoration: none; border: 1px solid transparent; }
.btn:hover { border-color: var(--accent); }
.session-foot { margin-top: 40px; padding-top: 20px; border-top: 1px dashed var(--line); color: var(--text-2); }

.card .mat-head { margin-bottom: 4px; }

/* 본문 */
.content h3 { font-size: 23px; line-height: 1.35; margin: 52px 0 14px; padding-bottom: 10px; border-bottom: 1px solid var(--line); letter-spacing: -0.01em; }
.content h4 { font-size: 19px; margin: 32px 0 10px; }
.content h5 { font-size: 16.5px; margin: 24px 0 8px; }
.content p { margin: 10px 0; }
.content hr { display: none; }
.content ul, .content ol { padding-left: 1.4em; margin: 10px 0; }
.content li { margin: 4px 0; }
.content li::marker { color: var(--text-3); }
.indent { padding-left: 1.2em; }
.step { display: flex; align-items: center; gap: 10px; margin: 36px 0 10px; font-weight: 700; font-size: 17px;
  padding: 10px 14px; background: var(--accent-soft); color: var(--accent-text); border-radius: 10px; }
.step-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); flex: none; }

.table-wrap { overflow-x: auto; margin: 14px 0; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); }
table { width: 100%; border-collapse: collapse; font-size: 14.5px; line-height: 1.6; }
th, td { padding: 10px 14px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); }
th { background: var(--surface-2); font-weight: 700; font-size: 13.5px; color: var(--text-2); white-space: nowrap; }
tr:last-child td { border-bottom: 0; }
td.nowrap { white-space: nowrap; }
td.chk { text-align: center; width: 64px; }
table.checklist tr:has(input:checked) td:not(.chk) { color: var(--text-3); text-decoration: line-through; }
input[type="checkbox"] { width: 18px; height: 18px; accent-color: var(--accent); cursor: pointer; vertical-align: middle; }
.todo { display: flex; gap: 10px; align-items: center; padding: 6px 0; cursor: pointer; }
.todo:has(input:checked) span { color: var(--text-3); text-decoration: line-through; }

.overview { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin: 16px 0 20px; }
.ov-card { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; font-size: 14.5px; line-height: 1.6; }
.ov-k { font-size: 13px; font-weight: 700; color: var(--text-2); margin-bottom: 4px; }

.note { display: flex; gap: 12px; padding: 14px 16px; border-radius: 10px; margin: 16px 0; background: var(--surface-2); font-size: 15px; line-height: 1.7; }
.note-k { flex: none; font-size: 12.5px; font-weight: 700; padding-top: 2px; white-space: nowrap; }
.note.tip { background: var(--tip-soft); } .note.tip .note-k { color: var(--tip); }
.note.key { background: var(--key-soft); font-weight: 600; } .note.key .note-k { color: var(--key); }
.note.warn { background: var(--warn-soft); } .note.warn .note-k { color: var(--warn); }

.codebox, .prompt, .result { margin: 14px 0; border-radius: 10px; overflow: hidden; }
.codebox { background: var(--code-bg); border: 1px solid var(--line); }
.code-head, .prompt-head { display: flex; align-items: center; justify-content: space-between; padding: 6px 8px 6px 14px; min-height: 36px; }
.code-head { justify-content: flex-end; }
.code-head .lang { margin-right: auto; font-size: 12px; color: var(--text-3); font-weight: 600; }
.prompt { background: var(--prompt-bg); color: var(--prompt-text); }
.prompt-head { background: var(--prompt-head); }
.prompt-tag { font-size: 13px; font-weight: 700; }
pre { margin: 0; padding: 12px 16px 16px; overflow-x: auto; white-space: pre-wrap; word-break: break-word;
  font-family: "D2Coding", Consolas, "SF Mono", "Malgun Gothic", monospace; font-size: 14px; line-height: 1.65; }
.codebox pre { padding-top: 0; }
.copy { border: 1px solid var(--line); background: var(--surface); color: var(--text); border-radius: 6px; padding: 3px 10px;
  font: inherit; font-size: 12.5px; cursor: pointer; }
.prompt .copy { background: transparent; color: var(--prompt-text); border-color: #4a5068; }
.copy.done { background: var(--key); color: #fff; border-color: var(--key); }

.result { background: var(--key-soft); border: 1px solid color-mix(in srgb, var(--key) 25%, transparent); }
.content p.result-label { margin: 18px 0 6px; font-size: 14px; font-weight: 700; color: var(--key); }
.result-head { padding: 8px 14px 0; font-size: 13px; font-weight: 700; color: var(--key); }
.result pre { padding-top: 6px; }

details.toggle { border: 1px solid var(--line); border-radius: 10px; margin: 16px 0; background: var(--surface); }
details.toggle summary { cursor: pointer; padding: 12px 16px; font-weight: 600; }
.toggle-body { padding: 0 16px 12px; }

.footer { margin-top: 80px; font-size: 13px; color: var(--text-3); }

@media (max-width: 960px) {
  .layout { grid-template-columns: 1fr; }
  .sidebar { position: fixed; left: 0; top: 56px; width: min(320px, 86vw); background: var(--surface); z-index: 30;
    transform: translateX(-100%); transition: transform .25s; box-shadow: 0 10px 30px rgba(0,0,0,.15); }
  body.nav-open .sidebar { transform: none; }
  #menuBtn { display: inline-block; }
  main { padding: 24px 16px 100px; }
  .progress .bar { width: 80px; }
  .overview { grid-template-columns: 1fr; }
  .card { padding: 18px 16px; }
}
#progTxt { white-space: nowrap; }
@media (max-width: 520px) { .progress .label, .progress .cnt { display: none; } .topbar { padding: 0 12px; gap: 8px; } .topbar .brand { font-size: 14px; } .progress .bar { width: 56px; } }
@media print {
  .topbar, .sidebar, .copy, .session-foot .btn { display: none !important; }
  .layout { display: block; } main { padding: 0; }
  details.toggle { display: block; } details.toggle > .toggle-body { display: block; }
}
</style>
</head>
